    <Box style={{ width: 390, height: 230, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: 20, justifyContent: 'center' }}>
      <Text style={{ fontSize: 54, color: '#0E3F8C', fontWeight: 'bold' }}>16</Text>
      <Text style={{ fontSize: 18, color: '#1A2230', fontWeight: 'bold' }}>16 条可判读证据</Text>
