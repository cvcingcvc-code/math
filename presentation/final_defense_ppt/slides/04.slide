    <Box style={{ width: 390, height: 230, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: 20, justifyContent: 'center' }}>
      <Text style={{ fontSize: 54, color: '#D9534F', fontWeight: 'bold' }}>54</Text>
