<Slide style={{ width: 1280, height: 720, background: '#F7F9FC', padding: 40 }}>
  <Box style={{ height: 88, borderBottom: '3px solid #1E4FA8', justifyContent: 'center' }}><Text style={{ fontSize: 36, color: '#0E3F8C', fontWeight: 'bold' }}>五条验证路径，回答同一个问题</Text><Text style={{ fontSize: 18, color: '#4A5568', marginTop: 6 }}>当 score 看似稳定时，evidence support 是否也稳定？</Text></Box>
  <Box style={{ height: 420, flexDirection: 'row', gap: 16, paddingTop: 24 }}>
    <Box style={{ width: 224, height: 360, background: '#FFFFFF', border: '1px solid #D6DCE5', padding: 18, gap: 12 }}><Text style={{ fontSize: 22, color: '#1E4FA8', fontWeight: 'bold' }}>01 Robustness</Text><Text style={{ fontSize: 19, color: '#1A2230', lineHeight: 1.4 }}>693 = 21×11×3<br />660 defined<br />33 undefined</Text></Box>
    <Box style={{ width: 224, height: 360, background: '#FFFFFF', border: '1px solid #D6DCE5', padding: 18, gap: 12 }}><Text style={{ fontSize: 22, color: '#1E4FA8', fontWeight: 'bold' }}>02 Perturbation</Text><Text style={{ fontSize: 19, color: '#1A2230', lineHeight: 1.4 }}>±10% / ±20%<br /><span style={{ color: '#D9534F', fontWeight: 'bold' }}>0 flips</span><br />ranking N/A</Text></Box>
    <Box style={{ width: 224, height: 360, background: '#FFFFFF', border: '1px solid #D6DCE5', padding: 18, gap: 12 }}><Text style={{ fontSize: 22, color: '#1E4FA8', fontWeight: 'bold' }}>03 Ablation</Text><Text style={{ fontSize: 19, color: '#1A2230', lineHeight: 1.4 }}>support falls<br />coverage falls<br />score can persist</Text></Box>
    <Box style={{ width: 224, height: 360, background: '#FFFFFF', border: '1px solid #D6DCE5', padding: 18, gap: 12 }}><Text style={{ fontSize: 22, color: '#1E4FA8', fontWeight: 'bold' }}>04 Failure</Text><Text style={{ fontSize: 19, color: '#1A2230', lineHeight: 1.4 }}>ABSTAIN<br />NO_EFFECTIVE_EVIDENCE<br />not zero</Text></Box>
    <Box style={{ width: 224, height: 360, background: '#FFFFFF', border: '1px solid #D6DCE5', padding: 18, gap: 12 }}><Text style={{ fontSize: 22, color: '#1E4FA8', fontWeight: 'bold' }}>05 Transfer / ML</Text><Text style={{ fontSize: 19, color: '#1A2230', lineHeight: 1.4 }}>constraint<br />not superiority<br />not generalization</Text></Box>
  </Box>
  <Box style={{ height: 90, background: '#0E3F8C', padding: 20, justifyContent: 'center' }}><Text style={{ fontSize: 27, color: '#FFFFFF', fontWeight: 'bold' }}>五条路径不是五个新主张，而是同一个可审查问题的五种压力测试</Text></Box>
  <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}><Text style={{ fontSize: 14, color: '#8B97A8' }}>不新增实验解释，只收束既有冻结证据</Text><Text style={{ fontSize: 14, color: '#0E3F8C' }}>06 / 10</Text></Box>
</Slide>