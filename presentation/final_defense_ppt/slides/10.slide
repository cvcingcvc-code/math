  <Box style={{ height: 220, padding: 32, justifyContent: 'center', background: '#E8EFF8' }}><Text style={{ fontSize: 34, color: '#1E4FA8', fontWeight: 'bold' }}>Score Stability ≠ Evidence Support Stability</Text><Text style={{ fontSize: 23, color: '#1A2230', marginTop: 14 }}>稳定的 score 不能替代稳定的 evidence support。</Text></Box>
  <Box style={{ height: 260, paddingTop: 26, flexDirection: 'row', gap: 16 }}><Box style={{ width: 270, height: 180, background: '#FFFFFF', border: '1px solid #D6DCE5', padding: 20 }}><Text style={{ fontSize: 21, color: '#1E4FA8', fontWeight: 'bold' }}>01 研究问题</Text><Text style={{ fontSize: 18, color: '#4A5568', marginTop: 14, lineHeight: 1.4 }}>Observed result 能否可靠解释？</Text></Box><Box style={{ width: 270, height: 180, background: '#FFFFFF', border: '1px solid #D6DCE5', padding: 20 }}><Text style={{ fontSize: 21, color: '#1E4FA8', fontWeight: 'bold' }}>02 模型链路</Text><Text style={{ fontSize: 18, color: '#4A5568', marginTop: 14, lineHeight: 1.4 }}>Raw → Reliability → Support</Text></Box><Box style={{ width: 270, height: 180, background: '#FFFFFF', border: '1px solid #D6DCE5', padding: 20 }}><Text style={{ fontSize: 21, color: '#1E4FA8', fontWeight: 'bold' }}>03 主结果</Text><Text style={{ fontSize: 18, color: '#4A5568', marginTop: 14, lineHeight: 1.4 }}>70 / 16 / 54；coverage 下降</Text></Box><Box style={{ width: 270, height: 180, background: '#FFFFFF', border: '2px solid #D9534F', padding: 20 }}><Text style={{ fontSize: 21, color: '#D9534F', fontWeight: 'bold' }}>04 失败案例</Text><Text style={{ fontSize: 18, color: '#4A5568', marginTop: 14, lineHeight: 1.4 }}>P108 → ABSTAIN</Text></Box></Box>
