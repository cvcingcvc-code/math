<Slide style={{ width: 1280, height: 720, background: '#F7F9FC', padding: 40 }}>
  <Box style={{ height: 104, background: '#1E4FA8', padding: 22, justifyContent: 'center' }}>
    <Text style={{ fontSize: 25, color: '#FFFFFF', fontWeight: 'bold' }}>结论与现场 Demo</Text>
  </Box>
  <Box style={{ height: 186, flexDirection: 'row', gap: 25, paddingTop: 22 }}>
    <Box style={{ width: 390, height: 186, background: '#FFFFFF', border: '1px solid #D6DCE5', padding: 18 }}>
      <Text style={{ fontSize: 10, color: '#8B97A8' }}>01</Text>
      <Text style={{ fontSize: 17, color: '#1E4FA8', fontWeight: 'bold' }}>问题</Text>
      <Text style={{ fontSize: 12, color: '#1A2230', marginTop: 8 }}>观测结果能否直接当作可靠证据？</Text>
    </Box>
    <Box style={{ width: 390, height: 186, background: '#FFFFFF', border: '1px solid #D6DCE5', padding: 18 }}>
      <Text style={{ fontSize: 10, color: '#8B97A8' }}>02</Text>
      <Text style={{ fontSize: 17, color: '#1E4FA8', fontWeight: 'bold' }}>模型</Text>
      <Text style={{ fontSize: 12, color: '#1A2230', marginTop: 8 }}>原始表现 → 证据可靠性 → 证据支持 → 决策</Text>
    </Box>
    <Box style={{ width: 390, height: 186, background: '#FFFFFF', border: '1px solid #D6DCE5', padding: 18 }}>
      <Text style={{ fontSize: 10, color: '#8B97A8' }}>03</Text>
      <Text style={{ fontSize: 17, color: '#1E4FA8', fontWeight: 'bold' }}>结果</Text>
      <Text style={{ fontSize: 12, color: '#1A2230', marginTop: 8 }}>分数不变；支持 16 → 6</Text>
    </Box>
  </Box>
  <Box style={{ height: 152, background: '#F0F5FC', borderLeft: '5px solid #1E4FA8', padding: 20, justifyContent: 'center' }}>
    <Text style={{ fontSize: 21, color: '#1A2230', fontWeight: 'bold' }}>我们真正增加的，不是一个更高的分数，</Text>
    <Text style={{ fontSize: 21, color: '#0E3F8C', fontWeight: 'bold' }}>而是让模型知道：什么时候证据不够。</Text>
  </Box>
  <Box style={{ height: 60, paddingTop: 14 }}>
    <Text style={{ fontSize: 14, color: '#1E4FA8', fontWeight: 'bold' }}>现场 Demo：离线展示页 + 冻结图 F1–F6</Text>
    <Text style={{ fontSize: 10, color: '#8B97A8' }}>（不依赖网络，断网可讲）</Text>
  </Box>
  <Box style={{ height: 24 }}>
    <Text style={{ fontSize: 9.5, color: '#8B97A8' }}>状态：AI 临时标注 AI_PROVISIONAL · 仅开发阶段 DEVELOPMENT_ONLY · 尚未人工验证 NOT_HUMAN_VALIDATED</Text>
  </Box>
  <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 9, color: '#8B97A8' }}>起名困难队 · 张镇源</Text><Text style={{ fontSize: 10, color: '#0E3F8C' }}>10 / 10</Text>
  </Box>
