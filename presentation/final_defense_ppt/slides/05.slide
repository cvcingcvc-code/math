    <Box style={{ width: 402, height: 470, padding: 24, gap: 18, background: '#F0F5FC' }}><Text style={{ fontSize: 25, color: '#0E3F8C', fontWeight: 'bold' }}>锁定机制</Text><Text style={{ fontSize: 21, color: '#1A2230', lineHeight: 1.4 }}>16 条可判读记录共享：</Text><Text style={{ fontSize: 21, color: '#1A2230', lineHeight: 1.4 }}>prompt=true<br />context=false<br />confidence=medium<br />R = 0.375</Text><Box style={{ borderTop: '2px solid #1E4FA8', paddingTop: 14 }}><Text style={{ fontSize: 21, color: '#1E4FA8', fontWeight: 'bold' }}>weight：16 → 12 → 6 → 6</Text><Text style={{ fontSize: 21, color: '#1E4FA8', fontWeight: 'bold', marginTop: 8 }}>coverage：0.228571 → 0.085714</Text></Box></Box>
  </Box>
