      <Text style={{ fontSize: 19, color: '#1E4FA8', fontWeight: 'bold' }}>22.86% → 8.57%</Text>
      <Text style={{ fontSize: 8.5, color: '#8B97A8', lineHeight: 1.4 }}>0.228571 → 0.171429 → 0.085714 → 0.085714</Text>
