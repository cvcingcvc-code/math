<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 40 }}>
  <Box style={{ height: 88, borderBottom: '3px solid #1E4FA8', justifyContent: 'center' }}>
    <Text style={{ fontSize: 30, color: '#0E3F8C', fontWeight: 'bold' }}>两个问题必须分开看</Text>
    <Text style={{ fontSize: 13, color: '#4A5568', marginTop: 6 }}>表现有多高，不等于证据有多可信</Text>
  </Box>
  <Box style={{ height: 510, flexDirection: 'row', gap: 28, paddingTop: 18 }}>
    <Box style={{ width: 700, height: 480, border: '1px solid #D6DCE5', padding: 12, background: '#F7F9FC' }}>
      <Image src="assets/F2_raw_vs_adjusted.svg" style={{ width: 676, height: 456, objectFit: 'contain' }} />
    </Box>
    <Box style={{ width: 460, height: 480, padding: 22, gap: 20, background: '#F0F5FC' }}>
      <Text style={{ fontSize: 19, color: '#0E3F8C', fontWeight: 'bold' }}>两个概念</Text>
      <Text style={{ fontSize: 19, color: '#1A2230', fontWeight: 'bold', lineHeight: 1.4 }}>表现有多高<Text style={{ fontSize: 10.5, color: '#8B97A8' }}>（Raw Signal）</Text></Text>
      <Text style={{ fontSize: 19, color: '#1A2230', fontWeight: 'bold', lineHeight: 1.4 }}>证据有多可信<Text style={{ fontSize: 10.5, color: '#8B97A8' }}>（Evidence Reliability）</Text></Text>
      <Box style={{ background: '#FDECEA', borderLeft: '5px solid #D9534F', padding: 14 }}>
        <Text style={{ fontSize: 17, color: '#D9534F', fontWeight: 'bold' }}>高表现，不一定有高证据支持。</Text>
      </Box>
      <Text style={{ fontSize: 11, color: '#4A5568', lineHeight: 1.4 }}>归一化分数不变，不代表支持范围不变。</Text>
    </Box>
  </Box>
  <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 9.5, color: '#8B97A8' }}>冻结图 F2 · 原始表现 vs 调整后表现</Text><Text style={{ fontSize: 10, color: '#0E3F8C' }}>02 / 10</Text>
  </Box>
</Slide>
