<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 40 }}>
  <Box style={{ height: 88, borderBottom: '3px solid #1E4FA8', justifyContent: 'center' }}><Text style={{ fontSize: 36, color: '#0E3F8C', fontWeight: 'bold' }}>失败不是 0 分：ABSTAIN 与 NO_EFFECTIVE_EVIDENCE</Text></Box>
  <Box style={{ height: 500, flexDirection: 'row', gap: 28, paddingTop: 18 }}>
    <Box style={{ width: 690, height: 470, border: '1px solid #D6DCE5', padding: 12, background: '#F7F9FC' }}><Image src="assets/F5_ablation_refusal.svg" style={{ width: 664, height: 444, objectFit: 'contain' }} /></Box>
    <Box style={{ width: 460, height: 470, padding: 22, gap: 17 }}><Text style={{ fontSize: 25, color: '#0E3F8C', fontWeight: 'bold' }}>三个反例</Text><Box style={{ background: '#E8EFF8', padding: 14 }}><Text style={{ fontSize: 20, color: '#1A2230', lineHeight: 1.35 }}>P108：L6 · R=0.375 · Adj=2.25</Text><Text style={{ fontSize: 20, color: '#D9534F', fontWeight: 'bold', marginTop: 6 }}>LOW_SUPPORT / ABSTAIN</Text></Box><Box style={{ background: '#F0F5FC', padding: 14 }}><Text style={{ fontSize: 20, color: '#1A2230', lineHeight: 1.35 }}>P105：L2 · R=0.375 · Adj=0.75</Text><Text style={{ fontSize: 20, color: '#D9534F', fontWeight: 'bold', marginTop: 6 }}>LOW_SUPPORT</Text></Box><Box style={{ border: '2px solid #D9534F', padding: 14 }}><Text style={{ fontSize: 20, color: '#1A2230', lineHeight: 1.35 }}>P072 / P035：Adjusted=null</Text><Text style={{ fontSize: 20, color: '#D9534F', fontWeight: 'bold', marginTop: 6 }}>NO_EFFECTIVE_EVIDENCE</Text></Box><Text style={{ fontSize: 20, color: '#4A5568', lineHeight: 1.4 }}>ABSTAIN 是合理输出，不是模型失败。</Text></Box>
  </Box>
  <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}><Text style={{ fontSize: 14, color: '#D9534F' }}>无有效证据时不填 0，避免制造虚假的确定性</Text><Text style={{ fontSize: 14, color: '#0E3F8C' }}>07 / 10</Text></Box>
</Slide>